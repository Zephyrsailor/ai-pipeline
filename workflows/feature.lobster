name: feature-dev
args:
  repo:
    description: "Target repository path"
  request:
    description: "Feature request description"
  request_id:
    description: "Unique request identifier"
steps:
  - id: architect
    run: ./bin/architect.sh
    env:
      REPO: "${repo}"
      REQUEST: "${request}"
      REQUEST_ID: "${request_id}"

  - id: arch_approval
    approval:
      prompt: "Review architecture plan. Approve to start implementation?"
    stdin: $architect.json

  - id: code
    run: ./bin/code.sh
    env:
      REPO: "${repo}"
      REQUEST_ID: "${request_id}"
    stdin: $architect.json
    when: $arch_approval.approved

  - id: review
    run: ./bin/review-loop.sh
    env:
      REPO: "${repo}"
      MAX_ROUNDS: "3"
    when: $arch_approval.approved

  - id: test
    run: ./bin/run-tests.sh
    env:
      REPO: "${repo}"
    when: $arch_approval.approved

  - id: release_approval
    approval:
      prompt: "Tests done. Approve PR creation?"
    stdin: $test.json
    when: $arch_approval.approved

  - id: create_pr
    run: |
      cd "${repo}" && gh pr create \
        --title "feat: ${request_id}" \
        --body "Auto-generated by ai-pipeline" \
        2>&1 | jq -Rs '{pr_url: .}'
    when: $release_approval.approved

  - id: metrics
    run: ./bin/log-metric.sh
    env:
      REQUEST_ID: "${request_id}"
      WORKFLOW: "feature"
      REVIEW_ROUNDS: "$(echo '$review.json' | jq -r '.rounds // 0')"
      TEST_ATTEMPTS: "$(echo '$test.json' | jq -r '.attempts // 1')"
